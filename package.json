{
  "name": "pre-ipo-trading-platform",
  "version": "1.0.0",
  "description": "Tokenized pre-IPO trading platform with an event-sourced ledger, matching engine and point-in-time portfolio reconstruction.",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=20.10.0"
  },
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:migrate": "ts-node -T src/database/migrate.cli.ts",
    "db:seed": "ts-node -T src/database/seed.cli.ts",
    "db:reset": "ts-node -T src/database/migrate.cli.ts --reset && ts-node -T src/database/seed.cli.ts",
    "openapi": "ts-node -T scripts/generate-openapi.ts",
    "lint": "eslint \"{src,test,scripts}/**/*.ts\" --max-warnings 0",
    "format": "prettier --write \"{src,test,scripts}/**/*.ts\"",
    "test": "jest --config jest.config.ts --runInBand",
    "test:unit": "jest --config jest.config.ts --selectProjects unit",
    "test:e2e": "jest --config jest.config.ts --selectProjects e2e --runInBand",
    "test:cov": "jest --config jest.config.ts --coverage --runInBand"
  },
  "dependencies": {
    "@fastify/static": "^7.0.4",
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/platform-fastify": "^10.4.15",
    "@nestjs/platform-ws": "^10.4.15",
    "@nestjs/schedule": "^4.1.2",
    "@nestjs/swagger": "^8.1.0",
    "@nestjs/throttler": "^6.3.0",
    "@nestjs/websockets": "^10.4.15",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.36.4",
    "fastify": "^4.28.1",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.15",
    "@swc/core": "^1.10.1",
    "@swc/jest": "^0.2.37",
    "@types/bcryptjs": "^2.4.6",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.17.10",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.2",
    "@types/ws": "^8.5.13",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "jest": "^29.7.0",
    "prettier": "^3.4.2",
    "supertest": "^7.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  }
}
