# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=3000

# ---------------------------------------------------------------------------
# Database (matches docker-compose.yml)
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://preipo:preipo@localhost:5435/preipo
DATABASE_POOL_MAX=20

# Separate database used by `pnpm test:e2e`. Created automatically if missing.
TEST_DATABASE_URL=postgresql://preipo:preipo@localhost:5435/preipo_test

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
JWT_SECRET=replace-me-with-a-long-random-string
JWT_EXPIRES_IN=12h
SIGNUP_BONUS_USD=100000

# ---------------------------------------------------------------------------
# Market simulation
# ---------------------------------------------------------------------------
# Milliseconds between simulated price ticks.
PRICE_TICK_INTERVAL_MS=1000
# Deterministic seed for the GBM price process and synthetic depth ladder.
PRICE_RANDOM_SEED=20240601
# Set to false to freeze prices (used by deterministic tests).
PRICE_ENGINE_ENABLED=true
# Seconds of simulated market time per second of wall time. 3600 = 1s -> 1h.
MARKET_TIME_ACCELERATION=3600

# Synthetic order book depth used as the counterparty of last resort.
BOOK_LEVELS=10
BOOK_NOTIONAL_PER_LEVEL_USD=25000
BOOK_SPREAD_BPS=12

# ---------------------------------------------------------------------------
# Trading
# ---------------------------------------------------------------------------
TAKER_FEE_BPS=10
MAKER_FEE_BPS=0
# Circuit breaker: absolute price move over the window that trips the breaker.
CIRCUIT_BREAKER_THRESHOLD_BPS=1500
CIRCUIT_BREAKER_WINDOW_MS=60000
CIRCUIT_BREAKER_COOLDOWN_MS=30000

# ---------------------------------------------------------------------------
# Rate limiting
# ---------------------------------------------------------------------------
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_LIMIT=300
