                  "  pm.collectionVariables.set('token', body.accessToken);",
                  "  pm.collectionVariables.set('userId', body.user.id);",
                  "  console.log('token stored for', body.user.email);",
                  "}",
                  "pm.test('authenticated', () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));"
                ]
